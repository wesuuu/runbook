# Frontend environment variables consumed by Vite.
# Copy to `frontend/.env.local` for local overrides.

# --- Feature flags (TD-0082) ---
# Offline/PWA stack. Default: false. Set to "true" to re-enable.
VITE_OFFLINE_ENABLED=false

# Self-service registration (F-0091). Default: on. To close the gate set this
# to the exact lowercase string "false" -- any other value (False, 0, no, off)
# leaves it ON. This is only the cosmetic half; the backend flag is the real
# gate. Must mirror BATCHRITE_FEATURES__REGISTRATION__ENABLED.
VITE_REGISTRATION_ENABLED=true
